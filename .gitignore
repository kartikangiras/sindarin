# python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.venv/
*.egg-info/
build/
dist/
.DS_Store
# secrets and local state (DDD §16.2): one env file for the seven processes, one state file per executor
/.env
.env.local
agents/*/.claude/
executor/*.db
executor/*.db-journal
executor/*.db-shm
executor/*.db-wal
executor/*.log
data/

# documentation stays local: only the READMEs and the agents' prompts are published
*.md
!README.md
!agents/*/AGENT.md
# landing page videos: served from their CDN on GitHub Pages, shipped with the hosted artifact only
docs/media/
.vercel/
