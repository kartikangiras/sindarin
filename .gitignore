# python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.venv/
*.egg-info/
build/
dist/
.DS_Store
# secrets and local state (DDD §16.2): one env file for the six processes, one state file per executor
/.env
.env.local
agents/*/.claude/
executor/*.db
executor/*.db-journal
executor/*.db-shm
executor/*.db-wal
executor/simulated-github.json
executor/*.log

# documentation stays local: only the READMEs and the agents' prompts are published
*.md
!README.md
!agents/*/AGENT.md
