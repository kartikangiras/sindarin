# Sindarin — the one env file. Copy to .env (gitignored, mode 600). Fill the first block; the rest
# is written by `sindarin bootstrap`. Each process is handed only its own lines: its Switch identity,
# SWITCH_BRIDGE_URL and the keys named for it below (ROOT_ENV_KEYS in src/sindarin/executor/config.py).
# Leave a key empty to go without: no model key → the deterministic stand-in agents, no
# Mattermost URL → the one bundled with the Switch stack.

# ── you ───────────────────────────────────────────────────────────────────────────────────────
# the three agents
ANTHROPIC_API_KEY=
# a Mattermost server of your own (read by bootstrap and the live scripts, never by a process).
# Switch signs in as this admin to create the agents' bot accounts (System Console → Integrations →
# Bot Accounts must be enabled); the demo people isaac, leonardo, john, vincent are created there.
# MATTERMOST_INTERNAL_URL is how the Switch container reaches the server when that differs
# (a server on this machine: http://host.docker.internal:<port>, which scripts/switch_stack.sh up
# allows in Switch's outbound guard); empty = same as MATTERMOST_URL.
MATTERMOST_URL=
MATTERMOST_INTERNAL_URL=
MATTERMOST_ADMIN_USER=
MATTERMOST_ADMIN_PASSWORD=
# the account you drive the demo from, put in every room and approver group (not the admin:
# Switch signs in as that one). Switch's stack seeds this pair on the bundled server; on a server
# of your own the bootstrap creates it with this password.
MATTERMOST_USER=
MATTERMOST_USER_PASSWORD=
MATTERMOST_TEAM_NAME=switch
SWITCH_BRIDGE_NAME=

# ── written by `sindarin bootstrap` ───────────────────────────────────────────────────────────
# Switch's agent protocol endpoint, shared by the five processes
SWITCH_BRIDGE_URL=http://localhost:8000
# sindarin-switch only: the Gateway credential that opens feature rooms (copied from the stack's .env)
SWITCH_GATEWAY_URL=
SWITCH_GATEWAY_EMAIL=
SWITCH_GATEWAY_PASSWORD=
# one Switch identity per process; the key is shown once by Switch and never printed again
ANALYST_SWITCH_AGENT_ID=
ANALYST_SWITCH_AGENT_API_KEY=
ANALYST_SWITCH_CONNECTION_ID=
BOOKKEEPER_SWITCH_AGENT_ID=
BOOKKEEPER_SWITCH_AGENT_API_KEY=
BOOKKEEPER_SWITCH_CONNECTION_ID=
PLANNER_SWITCH_AGENT_ID=
PLANNER_SWITCH_AGENT_API_KEY=
PLANNER_SWITCH_CONNECTION_ID=
TREASURY_SWITCH_AGENT_ID=
TREASURY_SWITCH_AGENT_API_KEY=
TREASURY_SWITCH_CONNECTION_ID=
SALES_SWITCH_AGENT_ID=
SALES_SWITCH_AGENT_API_KEY=
SALES_SWITCH_CONNECTION_ID=
SINDARIN_SWITCH_SWITCH_AGENT_ID=
SINDARIN_SWITCH_SWITCH_AGENT_API_KEY=
SINDARIN_SWITCH_SWITCH_CONNECTION_ID=
SINDARIN_LEDGER_SWITCH_AGENT_ID=
SINDARIN_LEDGER_SWITCH_AGENT_API_KEY=
SINDARIN_LEDGER_SWITCH_CONNECTION_ID=
# optional: path to a Google service-account JSON key; with executor/ledger.yaml sheet_url set,
# sindarin-ledger writes the budget, the planned lines and the paid payables back into the sheet
SINDARIN_LEDGER_GOOGLE_SA=
# optional: a Stripe secret key (sk_test_… for test mode). With executor/ledger.yaml
# payment_rail: stripe an approved payment run becomes one Stripe payout per payable; with
# invoicing: stripe a won deal becomes a real invoice the customer pays (a test card in test
# mode) and the receipt is booked when Stripe says paid. `uv run sindarin invoicing stripe`.
STRIPE_SECRET_KEY=
# optional: an Increase API key with executor/ledger.yaml payment_rail: increase; a run then
# becomes one ACH transfer per payable from an operating account. `uv run sindarin rail
# increase` provisions a free sandbox (no signup, no real money) and writes the key here.
INCREASE_API_KEY=
# optional connectors, each one line to turn on: `uv run sindarin connect hubspot|dropbox-sign|drive`
# HubSpot private-app token (sindarin-ledger): a proposed deal is created in the CRM, the CFO's
# yes closes it won, a deny closes it lost
HUBSPOT_TOKEN=
# where Stripe invoices are addressed in the demo (the signer's address when empty)
BILLING_CUSTOMER_EMAIL=
# Dropbox Sign (sindarin-ledger): the order form goes to this signer when a deal is approved,
# test mode, and the room is told when it is signed
DROPBOX_SIGN_API_KEY=
DROPBOX_SIGN_SIGNER_EMAIL=
DROPBOX_SIGN_SIGNER_NAME=
# Google Drive and Slides (sindarin-switch): a locked month's board pack (report, charts,
# exports, a deck) lands in this folder. Credentials: a service-account key here (share the
# folder with its email as editor), or leave it empty and sign in as yourself once with
# `gcloud auth application-default login --scopes=…drive,…presentations,…cloud-platform`
SINDARIN_GOOGLE_SA=
GOOGLE_DRIVE_FOLDER_ID=
