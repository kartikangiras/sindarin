# Copy to executor/mattermost.env (gitignored) to run the demo in a Mattermost server of your own
# instead of the one bundled with the Switch stack. `sindarin bootstrap`, `scripts/spike.py` and
# `scripts/rehearse.py` pick it up when it exists. Switch signs in as the admin below to create the
# agents' bot accounts (System Console → Integrations → Bot Accounts must be enabled) and the demo
# people isaac, leonardo, john, vincent are created on that server.
MATTERMOST_URL=https://your-team.cloud.mattermost.com   # as people and this machine reach it
MATTERMOST_INTERNAL_URL=                                 # as the Switch container reaches it; empty = same. A server on this Mac: http://host.docker.internal:8065
MATTERMOST_ADMIN_USER=                                   # a system admin (username or email)
MATTERMOST_ADMIN_PASSWORD=
MATTERMOST_TEAM_NAME=                                    # the team slug from the URL
SWITCH_BRIDGE_NAME=                                      # display name of the Gateway connection; empty = "Mattermost <host>"
