# Copy to executor/switch.env (gitignored). What sindarin-switch holds (DDD §4.2): its Switch key and a
# Gateway credential able to create rooms, add members and set instructions. Nothing from GitHub.
SWITCH_BRIDGE_URL=http://localhost:8000
SWITCH_AGENT_ID=                 # written by `sindarin bootstrap`
SWITCH_AGENT_API_KEY=            # written by `sindarin bootstrap`; shown once by Switch
SWITCH_CONNECTION_ID=            # uuid4, written by `sindarin bootstrap`
SWITCH_GATEWAY_URL=http://localhost:8000
SWITCH_GATEWAY_EMAIL=            # Gateway admin from ~/.sindarin/switch-stack/.env (bootstrap copies it)
SWITCH_GATEWAY_PASSWORD=         # same source; never printed
