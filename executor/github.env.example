# Copy to executor/github.env (gitignored). What sindarin-github holds (DDD §4.2): its Switch key and the
# one GitHub token that can merge to main, tag and publish on the sample repository. Nothing from Switch's Gateway.
SWITCH_BRIDGE_URL=http://localhost:8000
SWITCH_AGENT_ID=                 # written by `sindarin bootstrap`
SWITCH_AGENT_API_KEY=            # written by `sindarin bootstrap`; shown once by Switch
SWITCH_CONNECTION_ID=            # uuid4, written by `sindarin bootstrap`
GITHUB_TOKEN=                    # fine-grained PAT: contents + pull requests write on the sample repo; leave empty for github_mode: simulated
