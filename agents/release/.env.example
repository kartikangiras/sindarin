# Copy to agents/release/.env (gitignored). What `release` holds and nothing else (DDD §4.2, §16.2).
SWITCH_BRIDGE_URL=http://localhost:8000
SWITCH_AGENT_ID=                 # written by `sindarin bootstrap`
SWITCH_AGENT_API_KEY=            # written by `sindarin bootstrap`; shown once by Switch
SWITCH_CONNECTION_ID=            # uuid4, written by `sindarin bootstrap`
ANTHROPIC_API_KEY=               # the model key; leave empty and set SINDARIN_MODEL=fake for the stand-in
GITHUB_TOKEN=                  # read-only PAT on the sample repo (DDD §4.2); unused in github_mode: simulated
